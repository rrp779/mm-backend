# Copy this file to ".env" and fill in the values.
# Do NOT commit your real ".env" (it contains secrets).

# Server
PORT=5500
MONGO_URI=mongodb://127.0.0.1:27017/mm-backend

# Shopify Admin API
# Example: makeup-mystery-india.myshopify.com
SHOPIFY_STORE=your-store.myshopify.com
# Shopify Admin API access token (keep secret)
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Shopify Storefront API token, used to create mobile customer sessions for WhatsApp OTP login
SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Reviews
# When true, backend verifies purchaser via Shopify Admin API before accepting reviews.
REQUIRE_PURCHASED_REVIEW=true

# Razorpay (use TEST keys for testing)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Shiprocket (for Order Tracking)
SHIPROCKET_EMAIL=n34@gmail.com
SHIPROCKET_PASSWORD=n34@12345

# ImageKit (optional, used for uploads/media if enabled in backend)
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# WhatsApp OTP login
# In production these are required. Use an approved WhatsApp template with the OTP variable.
WHATSAPP_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_VERSION=v20.0
WHATSAPP_OTP_TEMPLATE=otp_login
WHATSAPP_OTP_LANGUAGE=en
OTP_SECRET=change-this-long-random-secret
OTP_CUSTOMER_EMAIL_DOMAIN=phone.makeupmystery.local
WHATSAPP_OTP_TTL_SEC=300
WHATSAPP_OTP_MAX_ATTEMPTS=5
ALLOW_DEV_OTP=false
# For local testing only. Never enable in production.
